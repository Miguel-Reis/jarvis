{
  "name": "palkeeper",
  "version": "0.1.0",
  "description": "Daemon de gestão para servidor dedicado de Palworld — REST API + RCON, backups, restarts e eventos",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
