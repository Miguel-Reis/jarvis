{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"src/**/*.ts",
			"src/**/*.tsx",
			"ui/src/**/*.ts",
			"ui/src/**/*.tsx",
			"!src/sites/fixtures/**",
			"!src/roles/**"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off",
				"useIterableCallbackReturn": "warn",
				"noAssignInExpressions": "warn",
				"noArrayIndexKey": "warn"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn"
			},
			"a11y": {
				"recommended": false
			},
			"style": {
				"recommended": false
			},
			"complexity": {
				"recommended": false
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
